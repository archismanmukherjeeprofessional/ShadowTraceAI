
DATABASE_URL=<DB link>
# ShadowTrace AI — Environment Variables
# Copy this file to .env and fill in your values.
# All OSINT keys are optional — sources degrade gracefully without them.

# ─────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=<SESSION_SECRET>

NODE_ENV=<status>

# ─────────────────────────────────────────────────────────────
# REACT FRONTEND
# ─────────────────────────────────────────────────────────────
# The origin of your React dev server. CORS is locked to this value.
FRONTEND_ORIGIN=<Frontend url>

# ─────────────────────────────────────────────────────────────
# LLM / AI ENGINE
# Leave LLM_API_KEY blank to use mock AI signals (raw_value: 0.5).
# ─────────────────────────────────────────────────────────────
LLM_API_KEY=<API Key>
LLM_MODEL_NAME=<model name>
LLM_API_BASE=<url>

# ─────────────────────────────────────────────────────────────
# OSINT SOURCES
# ─────────────────────────────────────────────────────────────

# GitHub Public API
# Without a token: 60 requests/hour (unauthenticated).
# With a token:  5000 requests/hour.
# Create a fine-grained PAT at https://github.com/settings/tokens
# Required scopes: none (public data only).
GITHUB_TOKEN=<pat_tkn>

# Reddit API
# Create an app at https://www.reddit.com/prefs/apps (choose "script").
# Used for: authenticated read-only user lookups.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Gravatar REST API (v3)
# Create an API key at https://gravatar.com/developers
# Used for: email-to-profile lookup.
GRAVATAR_API_KEY=<key>

# Maigret (500+ platform username checker)
# Install: pip install maigret
# If maigret is not on your system PATH, set the full path to the executable.
MAIGRET_PATH=<path>
